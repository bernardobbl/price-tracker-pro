VITE_API_BASE_URL=http://localhost:4000

# Supabase Auth (preencha com os dados do seu projeto Supabase)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Modo demonstração: "true" mostra o selo "dados de demonstração" (use quando o
# banco estiver populado pelo seed/amostra, não pelo arquivo real da ANP).
VITE_DEMO_MODE=false


