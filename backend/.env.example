PORT=4000

# Origens liberadas no CORS (URL do frontend). Aceita LISTA separada por vírgula —
# útil em produção para cobrir o domínio principal e os previews da Vercel.
# A barra final é ignorada (normalizada), então tanto faz ".app" ou ".app/".
# Ex.: FRONTEND_URL=https://price-tracker-pro.vercel.app,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Usuário de demonstração criado pelo script de seed (npm run seed)
DEMO_EMAIL=demo@pricetracker.pro
DEMO_PASSWORD=demo123456

# Supabase — em Settings → API Keys do painel.
# Use as chaves NOVAS: publishable (pública) e secret (backend). As legadas `anon`/
# `service_role` (JWT) ainda funcionam em projetos antigos, mas a Supabase as
# descontinua no fim de 2026 — os nomes das variáveis aqui continuam os mesmos.
# A secret key bypassa RLS: é ela que permite o ETL gravar em fuel_prices.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Ingestão da ANP (Série Histórica de Preços de Combustíveis — dado aberto).
# A ANP publica CSVs MENSAIS separados por grupo (precos-gasolina-etanol-MM.csv e
# precos-diesel-gnv-MM.csv) em .../shpc/dsan/ANO/.
#
# PADRÃO (recomendado): deixe ANP_YEAR/ANP_MONTHS COMENTADOS. O ingestor deriva os
# meses da data de execução (mês corrente + 2 anteriores, virada de ano tratada) —
# assim o job semanal acompanha o calendário sozinho e o dado nunca congela.
# Um mês ainda não publicado responde 404 e é pulado sem quebrar o lote.
#
# (Opcional) Pinar ano/meses — só para backfill histórico ou debug:
# ANP_YEAR=2025
# ANP_MONTHS=10,11,12
# (Opcional) Força um ÚNICO arquivo específico, ignorando ANP_YEAR/ANP_MONTHS.
# ANP_CSV_URL=https://www.gov.br/anp/pt-br/centrais-de-conteudo/dados-abertos/arquivos/shpc/dsan/2025/precos-gasolina-etanol-12.csv
# Cron do job semanal de ingestão embutido no backend (padrão: segunda 06:00).
# Use "off" para desligar — é o RECOMENDADO em produção no free tier, onde o
# processo hiberna e o cron pode nunca disparar; lá quem ingere é o GitHub Actions
# (.github/workflows/ingest.yml). Localmente, deixe a expressão para testar o job.
ANP_CRON=0 6 * * 1
# Fuso do cron acima (hosts rodam em UTC; sem isso "06:00" viraria 03:00 no Brasil).
ANP_CRON_TZ=America/Sao_Paulo
# Retenção automática (free tier do Supabase = 500 MB): após cada ingestão, apaga
# levantamentos com mais de N meses — o banco atinge um platô e nunca estoura o
# limite grátis. Padrão: 12 (calibrado com medição real: ~21-23 MB/mês → platô
# ~280 MB ≈ 56% do limite). Use "0" para desligar (banco cresce para sempre).
# Acompanhe o uso com `npm run db:stats`.
# RETENTION_MONTHS=12
# Se "true", roda uma ingestão imediatamente no boot (útil no 1º deploy/demo).
ANP_INGEST_ON_BOOT=false

# SMTP para envio dos alertas de preço (opcional — sem isso, emails são apenas logados)
SMTP_HOST=smtp.seu-provedor.com
SMTP_PORT=587
SMTP_USER=seu-usuario-smtp
SMTP_PASS=sua-senha-smtp
EMAIL_FROM="Price Tracker Pro <no-reply@seu-dominio.com>"
