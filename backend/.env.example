PORT=4000

# Origem liberada no CORS (URL do frontend)
FRONTEND_URL=http://localhost:5173

# Supabase (URL e anon key obrigatórios; service_role recomendado para o backend gravar preços)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-publica
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secret

# SMTP para envio dos alertas de preço (opcional — sem isso, emails são apenas logados)
SMTP_HOST=smtp.seu-provedor.com
SMTP_PORT=587
SMTP_USER=seu-usuario-smtp
SMTP_PASS=sua-senha-smtp
EMAIL_FROM="Price Tracker Pro <no-reply@seu-dominio.com>"
